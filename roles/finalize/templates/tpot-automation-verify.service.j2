# tpot-automation-verify.service
#
# GENERATED by this installer's finalize role. Every install run overwrites
# it; edit the role, not this file.
#
# WHAT IT IS FOR
#   T-Pot is not running until the box has rebooted, so an install that has
#   not rebooted cannot honestly be called verified. This installer refuses to
#   blur that: a completed install with the default reboot policy exits 20 --
#   "installed, pre-reboot checks passed, a reboot is required" -- and exit 0
#   is reserved for a box that has actually been checked after its reboot.
#
#   Somebody then has to do the checking. An operator can, by running
#   `install.sh --verify-only` once the box is back. An unattended caller --
#   Packer, cloud-init, a CI job that walked away -- will not, and this unit
#   is what closes that gap for them: on the next boot it runs the same
#   verification and rewrites the outcome file, so the record left behind is
#   true whether or not a human ever came back.
#
# WHY IT DISARMS ITSELF, WHICH IS THE PART THAT LOOKS OPTIONAL AND IS NOT
#   Upstream T-Pot's own playbook installs a daily reboot job in root's
#   crontab -- a randomised minute and an hour between 00 and 04, re-rolled on
#   every run of that playbook (installer/install/tpot.yml, the "T-Pot Daily
#   Reboot" cron task). This box therefore reboots every night for the rest of
#   its life.
#
#   A unit left armed would fire on every one of those boots and rewrite the
#   outcome file each time. What should be a dated record of one verified
#   install would instead re-assert itself indefinitely against a box nobody
#   has looked at since, and its timestamp would stop meaning anything. So:
#
#     * ConditionPathExists below gates the whole unit on a marker file;
#     * ExecStartPost deletes that marker.
#
#   systemd runs ExecStartPost only after the last ExecStart process has
#   exited successfully (systemd.service(5)), so the marker survives a FAILED
#   verification and the unit tries again -- which is the behaviour that was
#   wanted, because a verification that failed is exactly the one worth
#   repeating. A condition that is not met is not a failure: the unit is
#   skipped, quietly and successfully, on every later boot.
#
# WHY IT IS GIVEN AN ANSWER FILE, WHICH IS THE PART THAT LOOKS REDUNDANT
#   This installer takes its input from an answer file, the environment and
#   flags, merges the three, applies the documented defaults and hands the
#   result to Ansible. That merged document lives on tmpfs for the duration of
#   the run and is shredded when install.sh exits -- so a later run that is
#   given nothing gets the DEFAULTS, not what the box was installed with.
#
#   For an unattended verification that is not a detail. The account name, the
#   administrative SSH port, the dashboard and Elasticsearch ports, the T-Pot
#   edition and whether upstream's telemetry container is expected are all
#   inputs, and all of them are checked. Verify a box that changed any of them
#   against the defaults and every one of those checks is asking about
#   something that was never installed: the unit fails, retries within the
#   limits below, gives up, and never removes the marker -- so the machine
#   never reaches a verified state without a person.
#
#   So the install wrote the configuration it used to a file, and this unit
#   reads it back. It is the merged configuration WITHOUT any secret: the
#   dashboard password is not in it and is not needed, because --verify-only
#   drops the requirement for it. If that file is absent -- because the play
#   was not run by install.sh, or because the state directory was pointed
#   somewhere an answer file may not live -- ExecStart below carries no
#   --config at all and the run's own result document says so in its warnings.

[Unit]
Description=Post-boot verification of the unattended T-Pot install
Documentation=file://{{ tpot_finalize_dest }}/README.md
Documentation=file://{{ tpot_finalize_dest }}/docs/exit-codes.md

# Ordering only. network-online.target needs the Wants= as well: After= on
# its own does not pull the target into the boot transaction, and ordering
# against a target that was never started is ordering against nothing.
Wants=network-online.target
After=network-online.target
After=docker.service
# tpot.service is what actually starts the containers this unit is about to
# count. Verification retries on its own, so this is not load-bearing -- it
# only means the first attempt is made when there is something to see. If the
# unit is absent from the boot transaction, this line does nothing.
After=tpot.service

# The arming marker. Its presence is what makes this unit run at all, and
# install.sh reads the same path to report reboot.post_boot_verify_armed.
ConditionPathExists={{ tpot_finalize_marker_path }}
# And the installer copy itself, so that a tree someone has removed produces
# a skipped unit rather than a unit that fails on every boot forever.
ConditionPathExists={{ tpot_finalize_dest }}/install.sh
{% if tpot_finalize_verify_config_ok | default(false) | bool %}
# And the configuration this box was installed with. Same argument as the line
# above: a file someone has deleted should skip the unit rather than fail it on
# every boot for the rest of the machine's life -- install.sh refuses a
# --config that does not exist, with a usage error, before it looks at
# anything. This line is emitted only when that file was actually written.
ConditionPathExists={{ tpot_finalize_verify_config_path }}
{% endif %}

# A bound on the retrying, so that a box whose T-Pot is genuinely broken does
# not run verification in a loop until somebody notices. Five attempts inside
# an hour, and then the unit stops trying and stays failed. The marker is
# still there, and systemd's start-limit counter lives in the service
# manager's memory -- so the nightly reboot both resets the counter and gives
# the next attempt a freshly started T-Pot to look at.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=oneshot
# Type=oneshot disables the start timeout by default (systemd.service(5)), and
# that default is wanted: verification waits for containers to come up and can
# legitimately take several minutes. Do not add TimeoutStartSec= without
# checking it against tpot_verify_retries x tpot_verify_delay.

# --verify-only runs verify.yml rather than site.yml: it asserts and reports,
# and changes nothing. --json puts the result document on stdout, which for a
# unit means the journal, so `journalctl --unit {{ tpot_finalize_unit_name }}`
# holds the machine-readable answer as well as the human one.
#
# --config names the configuration this box was installed with; see the header
# for why verification without it checks the wrong box. Exactly one of the two
# lines below is written into this file, and which one it was is the answer to
# "was last night's verification about the machine I think it was". Running
# the same command by hand reproduces what the unit did, byte for byte.
#
# A --force-unsupported-os may follow, and only when this box was installed
# with it. That one setting cannot travel in the answer file: this installer's
# first preflight stage runs before any answer file is read and hears an
# override only from the command line or the environment, and that stage does
# gate a verification run. Without the flag, a box installed on a distribution
# outside the support matrix would fail this unit on every boot forever.
{% if tpot_finalize_verify_config_ok | default(false) | bool %}
ExecStart={{ tpot_finalize_dest }}/install.sh --verify-only --json --config {{ tpot_finalize_verify_config_path }}{{ tpot_finalize_verify_force_flags | default('') }}
{% else %}
ExecStart={{ tpot_finalize_dest }}/install.sh --verify-only --json{{ tpot_finalize_verify_force_flags | default('') }}
{% endif %}

# The disarm. Reached only on a successful verification -- see the header.
ExecStartPost=/bin/rm -f -- {{ tpot_finalize_marker_path }}

# on-failure, not always: Type=oneshot rejects always and on-success outright,
# and on-failure is the one that means what is wanted here -- retry a
# verification that did not pass, and stop as soon as one does. A failing
# ExecStartPost counts as a failure too, which is correct: a disarm that did
# not happen is the one condition that must not pass silently.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
